# Copie este arquivo para ".env" e coloque sua chave real aqui.
# Nunca compartilhe ou faça commit do arquivo .env (ele ja esta no .gitignore).
GOOGLE_API_KEY=coloque_sua_chave_aqui

# Volume 4: URL de conexao com o Postgres local (container Docker).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
# Nota: se a porta 5432 do seu Windows ja estiver em uso por outro Postgres,
# publique o container numa porta diferente (ex.: 5433) e ajuste aqui.
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5433/missao_ia
